{
  "mcpServers": {
    "junkyard": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server.ts"],
      "env": {
        "JUNKYARD_BOARD_URL": "${user_config.board_url}",
        "JUNKYARD_AGENT_ID": "${user_config.agent_id}",
        "JUNKYARD_AGENT_TOKEN": "${user_config.agent_token}"
      }
    }
  }
}
